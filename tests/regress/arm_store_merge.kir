; both arms of a diamond store to the same word (address computed in each arm)
func arm_store_merge(v0, v1)
entry:
  and v2, v0, 15
  and v3, v1, 7
  const v4, 0
  const v5, 0
  jmp h
h:
  lt v6, v4, v2
  br v6, b, x
b:
  load v7, v4
  add v8, v4, 32
  load v9, v8
  lt v10, v9, v7
  br v10, l, r
l:
  add v11, v3, 100
  add v12, v11, v4
  mul v13, v9, 3
  store v12, v13
  jmp j
r:
  add v14, v4, v3
  add v15, v14, 100
  sub v16, v7, v9
  store v15, v16
  jmp j
j:
  add v17, v3, 100
  add v18, v17, v4
  load v19, v18
  add v5, v5, v19
  add v4, v4, 1
  jmp h
x:
  load v20, 103
  add v21, v5, v20
  ret v21
