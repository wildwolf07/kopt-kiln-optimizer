; loads after stores that may or may not hit the same word (two may-alias stores)
func alias_forward(v0, v1, v2)
entry:
  and v3, v0, 7
  and v4, v1, 7
  and v5, v2, 7
  store v3, 100
  store v4, 200
  store v5, 300
  load v6, v3
  load v7, v4
  load v8, v5
  mul v9, v6, 1000
  mul v10, v7, 10
  add v11, v9, v10
  add v12, v11, v8
  load v13, 3
  add v14, v12, v13
  ret v14
