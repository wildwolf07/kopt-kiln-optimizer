; summation loop with step and bound form 2_lt (closed form)
func closed_form_2_lt(v0, v1, v2)
entry:
  and v3, v0, 255
  and v1, v1, 1023
  const v4, 5
  mul v6, v2, 2654435761
  jmp head
head:
  lt v7, v3, v1
  br v7, body, done
body:
  mul v8, v3, v3
  mul v9, v8, v6
  add v4, v4, v9
  shl v10, v3, 3
  sub v11, v10, v2
  add v4, v4, v11
  add v3, v3, 2
  jmp head
done:
  vstore 1, v3
  ret v4
