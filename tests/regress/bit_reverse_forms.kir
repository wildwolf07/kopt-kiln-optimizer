; bit reversal loops (or and add combine) with a nonzero starting value, plus a popcount of the same word
func bit_reverse_forms(v0, v1)
entry:
  const v2, 0
  mov v3, v1
  and v10, v1, 3
  const v11, 0
  jmp head
head:
  lt v4, v2, 32
  br v4, body, done
body:
  shr v5, v0, v2
  and v6, v5, 1
  sub v7, 31, v2
  shl v8, v6, v7
  or v3, v3, v8
  add v10, v10, v8
  add v11, v11, v6
  add v2, v2, 1
  jmp head
done:
  vstore 0, v10
  vstore 1, v11
  ret v3
