; Merge of 6 and 10 words (at 100 and 120) into 200..; the j<10 test inside the
; i<6 loop stays false once false (j is written only behind its true side), so
; monotone unswitching may version the loop. The volatile write orders effects.
func merge_tail(v30)
entry:
  const v0, 0
  const v1, 0
  const v2, 0
  jmp head
head:
  lt v3, v0, 6
  br v3, body, tail
body:
  lt v4, v1, 10
  br v4, both, onlya
both:
  add v5, 100, v0
  load v5, v5
  add v6, 120, v1
  load v7, v6
  lt v9, v7, v5
  br v9, takeb, takea
takea:
  add v11, 200, v2
  store v11, v5
  add v0, v0, 1
  jmp next
takeb:
  add v11, 200, v2
  store v11, v7
  add v1, v1, 1
  jmp next
onlya:
  add v12, 100, v0
  load v12, v12
  add v11, 200, v2
  store v11, v12
  add v0, v0, 1
  jmp next
next:
  add v2, v2, 1
  jmp head
tail:
  lt v21, v1, 10
  br v21, tb, done
tb:
  add v22, 120, v1
  load v23, v22
  add v24, 200, v2
  store v24, v23
  add v1, v1, 1
  add v2, v2, 1
  jmp tail
done:
  vstore 1, v2
  add v25, v2, v30
  ret v25
