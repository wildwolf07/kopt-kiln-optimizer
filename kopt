#!/bin/sh
# kopt - the Kiln optimizer.
#   kopt IN.kir --machine MACHINE.cfg [--profile PROFILE.prof] -o OUT.kir
# Runs the compiled optimizer (build with ./build.sh). If it fails for any
# reason, a fresh invocation expands unsupported fused operations in the input
# and writes that equivalent fallback without entering the optimizer.
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
if "$DIR/build/kopt-bin" "$@"; then
    exit 0
fi
exec "$DIR/build/kopt-bin" --fallback "$@"
